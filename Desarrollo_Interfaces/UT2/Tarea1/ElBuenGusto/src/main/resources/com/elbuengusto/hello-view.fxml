<?xml version="1.0" encoding="UTF-8"?>

<?import com.elbuengusto.componentes.LoginComponente?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.elbuengusto.HelloController"
            prefWidth="1024.0" prefHeight="576.0" style="-fx-background-color: #F6F5EC;">

    <!-- CENTRO: Alterna entre la Vista Principal (Pantallas 1 y 3) y el Componente Autónomo (Pantalla 2) -->
    <center>
        <StackPane>
            <!-- VISTA HOME (PANTALLAS 1 Y 3 DE TU MOCKUP) -->
            <AnchorPane fx:id="vistaHome" prefWidth="1024.0" prefHeight="535.0" style="-fx-background-color: #F6F5EC;">

                <!-- Barra superior verde oliva -->
                <HBox layoutX="0.0" layoutY="0.0" prefWidth="1024.0" prefHeight="86.0" alignment="CENTER_LEFT"
                      spacing="42.0" style="-fx-background-color: #556B2F; -fx-padding: 0 30 0 185;">
                    <Label text="Platos&#10;Grasosos" style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #000000;"/>
                    <Label text="Platos&#10;Ligeros" style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #000000;"/>
                    <Label text="Platos&#10;Secos" style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #000000;"/>
                    <Label text="Platos&#10;Caldosos" style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #000000;"/>
                    <Label text="Platos&#10;Dulces" style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #000000;"/>
                    <Label text="Platos&#10;Salados" style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #000000;"/>
                </HBox>

                <!-- Botón circular blanco INICIAR SESIÓN (Visible en Pantalla 1) -->
                <Button fx:id="btnIrLogin" layoutX="932.0" layoutY="8.0" prefWidth="70.0" prefHeight="70.0"
                        text="INICIAR&#10;SESIÓN" onAction="#mostrarPantallaLogin"
                        style="-fx-background-color: #FFFFFF; -fx-background-radius: 35px; -fx-text-alignment: center; -fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 10px; -fx-text-fill: #000000; -fx-cursor: hand;"/>

                <!-- Perfil "Raul" + Avatar Dinosaurio (Oculto al inicio, visible en Pantalla 3 tras confirmar login) -->
                <HBox fx:id="boxPerfilUsuario" layoutX="885.0" layoutY="8.0" alignment="CENTER_RIGHT" spacing="12.0" visible="false">
                    <Label fx:id="lblNombreUsuario" text="Raul" style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #000000;"/>
                    <ImageView fitWidth="70.0" fitHeight="70.0" preserveRatio="true">
                        <image><Image url="@img/avatar_raul.png"/></image>
                    </ImageView>
                </HBox>

                <!-- Logo El Buen Gusto sobresaliendo por debajo de la barra verde -->
                <ImageView fitWidth="148.0" fitHeight="142.0" layoutX="12.0" layoutY="6.0" preserveRatio="true">
                    <image><Image url="@img/logo.png"/></image>
                </ImageView>

                <!-- Título Central -->
                <Label layoutX="412.0" layoutY="112.0" text="LA COCINA SE AVECINA"
                       style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #000000;"/>

                <!-- Saludo ¡Bienvenido! (Visible en Pantalla 3 tras iniciar sesión) -->
                <Label fx:id="lblBienvenido" layoutX="855.0" layoutY="92.0" text="¡Bienvenido!" visible="false"
                       style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 25px; -fx-text-fill: #000000;"/>

                <!-- Dos imágenes apiladas a la izquierda con esquinas redondeadas -->
                <VBox layoutX="42.0" layoutY="165.0" spacing="14.0">
                    <ImageView fitWidth="460.0" fitHeight="165.0" preserveRatio="false">
                        <image><Image url="@img/camareros.png"/></image>
                    </ImageView>
                    <ImageView fitWidth="460.0" fitHeight="165.0" preserveRatio="false">
                        <image><Image url="@img/platos.png"/></image>
                    </ImageView>
                </VBox>

                <!-- Tarjeta blanca redondeada a la derecha con el párrafo centrado -->
                <StackPane layoutX="595.0" layoutY="165.0" prefWidth="390.0" prefHeight="344.0"
                           style="-fx-background-color: #FFFFFF; -fx-background-radius: 22px;">
                    <padding>
                        <Insets top="25.0" right="28.0" bottom="25.0" left="28.0"/>
                    </padding>
                    <Label wrapText="true" textAlignment="CENTER" alignment="CENTER"
                           style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 13.5px; -fx-text-fill: #000000; -fx-line-spacing: 3px;"
                           text="El aroma cálido y envolvente de nuestras cocinas es el alma de cada uno de los platos que creamos. Con una dedicación impecable en cada paso, combinamos ingredientes frescos y seleccionados para transformar recetas tradicionales en experiencias culinarias extraordinarias. Sentimos un orgullo sincero al mantener los más altos estándares de calidad, asegurando que cada bocado lleve consigo la pasión, el sabor y la excelencia que nos definen."/>
                </StackPane>
            </AnchorPane>

            <!-- VISTA LOGIN: Tu Componente Visual Autónomo (Pantalla 2 de tu Mockup) -->
            <!-- Configurado con las propiedades JavaBean 'titulo' y 'textoBoton' -->
            <LoginComponente fx:id="vistaLoginComponente"
                             titulo="INICIO DE SESION"
                             textoBoton="CONFIRMAR"
                             visible="false"/>
        </StackPane>
    </center>

    <!-- PIE DE PÁGINA COMÚN A LAS 3 PANTALLAS -->
    <bottom>
        <HBox alignment="CENTER" spacing="115.0" prefHeight="40.0" style="-fx-background-color: #556B2F;">
            <Hyperlink text="Términos de uso" style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #0000CD; -fx-underline: true; -fx-border-color: transparent;"/>
            <Hyperlink text="Aviso legal" style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #0000CD; -fx-underline: true; -fx-border-color: transparent;"/>
            <Hyperlink text="Política de privacidad y cookies" style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #0000CD; -fx-underline: true; -fx-border-color: transparent;"/>
            <Hyperlink text="Configuración de privacidad y cookies" style="-fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #0000CD; -fx-underline: true; -fx-border-color: transparent;"/>
        </HBox>
    </bottom>
</BorderPane>